# ==============================================================
# ALUMNI NETWORK DIRECTORY — ENVIRONMENT CONFIGURATION
# ==============================================================

# Server Port
PORT=5000

# Environment Mode: development | production | test
NODE_ENV=development

# MongoDB Atlas Database Connection URI
# Replace <username>, <password>, and <cluster-url> with your credentials
# Example: mongodb+srv://dbuser:StrongPassword123@cluster0.abcde.mongodb.net/alumni_directory?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/alumni_directory?retryWrites=true&w=majority

# JWT Secret for Signing Authentication Tokens
JWT_SECRET=super_secure_jwt_secret_change_this_in_production_2026

# Frontend Origin for CORS & Secure Cookie handling
FRONTEND_URL=http://localhost:5173

# Admin Account Password for Database Seed Script (development only)
ADMIN_SEED_PASSWORD=Admin@123456

# Frontend API Base URL (Relative '/api' works with Vite dev proxy and Vercel serverless)
VITE_API_BASE_URL=/api
